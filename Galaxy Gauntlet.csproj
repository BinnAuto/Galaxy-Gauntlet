<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GalaxyGauntlet</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="GalaxyGauntlet.APWorldGen\**" />
    <Compile Remove="GalaxyGauntlet.Common\**" />
    <EmbeddedResource Remove="GalaxyGauntlet.APWorldGen\**" />
    <EmbeddedResource Remove="GalaxyGauntlet.Common\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="GalaxyGauntlet.Common\GalaxyGauntlet.Common.csproj" />
  </ItemGroup>
</Project>